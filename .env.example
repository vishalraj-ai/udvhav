# GEMINI_API_KEY: Required for server-side Gemini multimodal AI inspection.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Comma-separated Google account email(s) authorized as the initial CivicAI Administrator
# during server-side Firebase Admin SDK token verification (/api/auth/bootstrap-verify).
# Defaults to the workspace owner account when left empty.
ADMIN_BOOTSTRAP_EMAIL=""

# Optional: Set PORT if deploying outside default 3000
PORT="3000"

# Optional: Firebase Cloud Messaging VAPID key. Leave empty to keep web push disabled without blocking preview.
VITE_FCM_VAPID_KEY=""
