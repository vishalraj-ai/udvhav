# GEMINI_API_KEY: Required for server-side Gemini multimodal AI inspection.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Set PORT if deploying outside default 3000
PORT="3000"

# Optional: Firebase Cloud Messaging VAPID key (only if FCM web push is configured in Firebase Console)
VITE_FCM_VAPID_KEY=""
