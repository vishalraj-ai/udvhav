        "translatedText": { "type": "string", "maxLength": 4000 },
        "landmark": { "type": "string", "maxLength": 300 },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "roadName": { "type": "string", "maxLength": 250 },
        "wardId": { "type": "string", "maxLength": 64 },
