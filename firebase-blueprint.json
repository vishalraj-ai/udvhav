        "isEmergency": { "type": "boolean" },
        "issueCount": { "type": "integer" },
        "evidenceCount": { "type": "integer" },
        "hasSuspiciousEvidence": { "type": "boolean" },
        "assignedInspectorUid": { "type": "string", "maxLength": 128 },
        "assignedOfficerUid": { "type": "string", "maxLength": 128 },
        "backupOfficerUid": { "type": "string", "maxLength": 128 },
