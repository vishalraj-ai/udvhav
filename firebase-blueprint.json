      "required": [
        "complaintCode",
        "citizenUid",
        "citizenName",
        "language",
        "rawText",
        "translatedText",
        "landmark",
        "latitude",
        "longitude",
        "roadName",
        "wardId",
        "wardName",
        "officeId",
        "officeName",
        "primaryDepartment",
        "severity",
        "status",
        "isEmergency",
        "issueCount",
        "evidenceCount",
        "hasSuspiciousEvidence",
        "assignedInspectorUid",
        "assignedOfficerUid",
        "backupOfficerUid",
        "createdAt",
        "updatedAt"
      ]
