    "EvidenceRecord": {
      "title": "EvidenceRecord",
      "description": "Uploaded complaint photo metadata, SHA-256 digest, EXIF inspection, and ImageGuard review state.",
      "type": "object",
      "properties": {
        "complaintId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
