    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated municipal platform user profile with RBAC role and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "role": { "type": "string", "enum": ["citizen", "inspector", "officer", "admin"] },
        "language": { "type": "string", "enum": ["en", "hi", "ta", "te", "kn", "mr", "bn", "gu"] },
        "department": { "type": "string", "maxLength": 100 },
        "wardId": { "type": "string", "maxLength": 64 },
        "phone": { "type": "string", "maxLength": 32 },
        "onDuty": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "language", "onDuty", "createdAt", "updatedAt"]
    },
